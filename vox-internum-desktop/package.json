{
  "name": "vox-internum-desktop",
  "version": "0.5.0",
  "description": "VOX INTERNUM — Dark Mechanicus messenger aggregator (Electron)",
  "main": "./out/main/index.js",
  "author": {
    "name": "Heretic OS",
    "email": "heretic@heretic-os.dev"
  },
  "license": "MIT",
  "homepage": "https://github.com/petushokmaxorka-ai/vox-internum",
  "desktopName": "vox-internum",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "tsc -p tsconfig.test.json && node --test scripts/test-camouflage.mjs scripts/test-imap.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:all": "npm run build && electron-builder -mlw"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^24",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "resedit": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "build": {
    "productName": "Vox Internum",
    "appId": "dev.heretic-os.vox-internum",
    "asar": true,
    "afterPack": "./scripts/patch-win-exe.cjs",
    "publish": {
      "provider": "github",
      "owner": "petushokmaxorka-ai",
      "repo": "vox-internum"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "artifactName": "Vox.Internum-${version}.${ext}",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;InstantMessaging;",
      "maintainer": "Heretic OS <heretic@heretic-os.dev>",
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vox Internum",
      "artifactName": "Vox.Internum-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "resources/icon.png"
    }
  }
}
